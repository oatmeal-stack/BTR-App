# Copy to .env.local and fill in from Supabase: Project Settings > Data API (or the Connect button).
# Both values are safe to publish. NEVER put the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
